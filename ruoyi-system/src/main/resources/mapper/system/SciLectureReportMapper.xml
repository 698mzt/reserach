    <sql id="selectSciLectureReportVo">
        select #{uid} uid,id,u.user_name userName,u.login_name,d.dept_name dname,u.user_id,p.dept_name, s.report_time, s.report_end_time, s.report_theme, s.host_unit, s.report_place, s.report_number, s.report_subject, s.report_duration, i.classification report_classify,s.state,s.createtime,s.report_url,s.report_keyanfen,i.rep_int_id
        from sci_lecture_report s left join sys_user u on  s.user_id=u.user_id
                                  left join sys_dept d on u.dept_id = d.dept_id
                                  left join sys_dept p on d.parent_id =p.dept_id
                                  left join sci_lecture_report_integral i on i.rep_int_id = s.report_classify
    </sql>

