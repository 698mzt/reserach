<!--    新增一条数据（讲座报告）-->
    <insert id="insertSciLectureReport" parameterType="SciLectureReport" useGeneratedKeys="true" keyProperty="id">
        insert into sci_lecture_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>

            <if test="reportTime != null and reportTime != ''">report_time,</if>
            <if test="reportEndTime != null and reportEndTime != ''">report_end_time,</if>
            <if test="reportTheme != null">report_theme,</if>
            <if test="hostUnit != null and hostUnit != ''">host_unit,</if>
            <if test="reportPlace != null and reportPlace != ''">report_place,</if>
            <if test="reportNumber != null">report_number,</if>
            <if test="reportSubject != null and reportSubject != ''">report_subject,</if>
            <if test="reportDuration != null">report_duration,</if>
            <if test="reportClassify != null">report_classify,</if>
            <if test="reportKeyanfen != null">report_keyanfen,</if>
            <if test="reportUrl != null">report_url,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>

            <if test="reportTime != null and reportTime != ''">#{reportTime},</if>
            <if test="reportEndTime != null and reportEndTime != ''">#{reportEndTime},</if>
            <if test="reportTheme != null">#{reportTheme},</if>
            <if test="hostUnit != null and hostUnit != ''">#{hostUnit},</if>
            <if test="reportPlace != null and reportPlace != ''">#{reportPlace},</if>
            <if test="reportNumber != null">#{reportNumber},</if>
            <if test="reportSubject != null and reportSubject != ''">#{reportSubject},</if>
            <if test="reportDuration != null">#{reportDuration},</if>
            <if test="reportClassify != null">#{reportClassify},</if>
            <if test="reportKeyanfen != null">#{reportKeyanfen},</if>
            <if test="reportUrl != null">#{reportUrl},</if>
         </trim>
    </insert>

    <select id="checkConflict" parameterType="SciLectureReport" resultType="Integer">
        SELECT COUNT(*)
        FROM sci_lecture_report
        WHERE host_unit = #{hostUnit}
        AND report_place = #{reportPlace}
        AND (
        (#{reportTime} &gt;= report_time AND #{reportTime} &lt; report_end_time)
        OR
        (#{reportEndTime} &gt; report_time AND #{reportEndTime} &lt;= report_end_time)
        OR
        (report_time &gt;= #{reportTime} AND report_end_time &lt;= #{reportEndTime})
        OR
        (#{reportTime} &gt;= report_time AND #{reportEndTime} &lt;= report_end_time)
        )
        <!-- 排除自身（如果是更新操作） -->
        <if test="id != null and id != ''">
            AND id != #{id}
        </if>
    </select>

<!--    修改保存讲座报告的语句-->
    <update id="updateSciLectureReport" parameterType="SciLectureReport">
        update sci_lecture_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="reportTime != null and reportTime != ''">report_time = #{reportTime},</if>
            <if test="reportTheme != null">report_theme = #{reportTheme},</if>
            <if test="hostUnit != null and hostUnit != ''">host_unit = #{hostUnit},</if>
            <if test="reportPlace != null and reportPlace != ''">report_place = #{reportPlace},</if>
            <if test="reportNumber != null">report_number = #{reportNumber},</if>
            <if test="reportSubject != null and reportSubject != ''">report_subject = #{reportSubject},</if>
            <if test="reportDuration != null">report_duration = #{reportDuration},</if>
            <if test="reportClassify != null">report_classify = #{reportClassify},</if>
            <if test="reportKeyanfen != null">report_keyanfen = #{reportKeyanfen},</if>
            <if test="reportUrl != null">report_url = #{reportUrl},</if>
            <if test="state != null">state = #{state},</if>
        </trim>
        where id = #{id}
    </update>

<!--    结项申请的保存-->
    <update id="SciLectureReportOverAdd" parameterType="SciLectureReport">
        update sci_lecture_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="state != null and state != '4'">state = #{state},</if>
            <if test="actualNumber != null">actual_number = #{actualNumber},</if>
            <if test="actualTime != null">actual_time = #{actualTime},</if>
        </trim>
        where id = #{id}
    </update>

    <!--    通过批阅修改讲座报告的状态-->
    <update id="criticism" parameterType="SciLectureReport">
        update sci_lecture_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="state != null">state = #{state},</if>
        </trim>
        where id = #{id}
    </update>

    <!--    科研室审核通过时修改讲座报告的科研分-->
    <update id="reportKeyanfen" parameterType="SciLectureReport">
        update sci_lecture_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="keyanfen != null">report_keyanfen = #{keyanfen},</if>
        </trim>
        where id = #{id}
    </update>

<!--    删除一条数据-->
    <delete id="deleteSciLectureReportById" parameterType="Integer">
        delete from sci_lecture_report_opinion where id in (select id from sci_lecture_report_opinion where baogao_id = #{id})
        delete from sci_lecture_report where id = #{id}
    </delete>

<!--    批量删除数据-->
    <delete id="deleteSciLectureReportByIds" parameterType="String">
        delete from sci_lecture_report where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

<!--    删除传入报告id对应的批阅记录

sql示例：
DELETE FROM sci_lecture_report_opinion
WHERE id IN (
    SELECT temp.id FROM (
        SELECT id FROM sci_lecture_report_opinion
        WHERE baogao_id IN (#{id1}, #{id2}, #{id3}, ...)
    ) AS temp
);
-->
    <delete id="deleteSciLectureReportOpinionBy" parameterType="String">
        delete from sci_lecture_report_opinion where id in (
            select temp.id from (
                select id from sci_lecture_report_opinion where baogao_id in
                <foreach item="id" collection="array" open="(" separator="," close=")">
                    #{id}
                </foreach>
            ) as temp
        )
    </delete>
    <select id="getStatsQuery" parameterType="map" resultMap="SciLectureReportResult">
    <include refid="selectSciLectureReportVo"/>
    where 1=1
    <if test="startTime != null and startTime != ''">
        and s.createtime >= #{startTime}
    </if>
    <if test="endTime != null and endTime != ''">
        and s.createtime &lt;= #{endTime}
    </if>
    <if test="college != null and college != '' and college!='null' ">
        AND p.dept_id = #{college}
    </if>
    <if test="major != null and major != '' and major!='null'">
        AND d.dept_id = #{major}
    </if>
    <if test="jobTitle != null and jobTitle != '' and jobTitle != 'null'">
        AND u.tea_zhicheng = #{jobTitle}
    </if>
    <if test="xingming != null and xingming != '' and xingming != 'null'">
        and u.user_name like concat('%', #{xingming}, '%')
    </if>
    <if test="mingcheng != null and mingcheng != ''">
        and s.mingcheng like concat('%', #{mingcheng}, '%')
    </if>
    <if test="fenlei != null and fenlei != ''">
        and s.fenlei = #{fenlei}
    </if>
    <if test="leixing != null and leixing != ''">
        and s.leixing = #{leixing}
    </if>
    <if test='state != null and state != "" and state!="null" and state =="1" '>
        AND s.state in (3,5,7,0)
    </if>
    <if test='state != null and state != "" and state!="null" and state =="2"'>
        AND s.state in (1,2,6)
    </if>
    <if test='state != null and state != "" and state!="null" and state =="3"'>
        AND s.state in (4)
    </if>
    order by s.createtime desc
</select>

</mapper>