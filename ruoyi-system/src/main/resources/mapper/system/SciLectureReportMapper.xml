    <!--    讲座报告首页项目申请数据查询-->
    <select id="selectSciLectureReportList" parameterType="SciLectureReport" resultMap="SciLectureReportResult">
        <include refid="selectSciLectureReportVo"/>
        where 1=1
        <if test="reportTheme != null  and reportTheme != ''">and report_theme like concat('%', #{reportTheme}, '%')
        </if>
        <if test="keyanshi != null  and keyanshi != ''">and d.dept_name like concat('%', #{keyanshi}, '%')</if>
        <if test="teacherName != null  and teacherName != ''">and u.user_name like concat('%', #{teacherName}, '%')</if>
        <if test="hostUnit != null  and hostUnit != ''">and host_unit like concat('%', #{hostUnit}, '%')</if>
        <if test="reportPlace != null  and reportPlace != ''">and report_place like concat('%', #{reportPlace}, '%')</if>
        <if test="reportSubject != null  and reportSubject != ''">and report_subject like concat('%', #{reportSubject}, '%')</if>
        <if test="reportClassify != null  and reportClassify != ''">and report_classify = #{reportClassify}</if>
        <if test="userId != null and userId != ''">and user_id = #{userId}</if>
        <if test="year != null  and year != ''">and YEAR(DATE_ADD(report_time,INTERVAL 1 MONTH)) = #{year}</if>
        <if test="statelist != null and statelist.size() > 0">and CAST(s.state AS UNSIGNED) in <foreach item="item" collection="statelist" open="(" separator="," close=")">#{item}</foreach></if>
        ${params.dataScope}
        <!-- 没有搜索条件时执行 -->
        <if test="uid != null and uid != '' and year != null  and year != ''
          and (reportTheme == null or reportTheme == '')
          and (keyanshi == null or keyanshi == '')
          and (teacherName == null or teacherName == '')
          and (hostUnit == null or hostUnit == '')
          and (reportPlace == null or reportPlace == '')
          and (reportSubject == null or reportSubject == '')
          and (reportClassify == null or reportClassify == '')">
            or (s.user_id = #{uid} and YEAR(DATE_ADD(report_time,INTERVAL 1 MONTH)) = #{year}
            <if test="statelist != null and statelist.size() > 0">and CAST(s.state AS UNSIGNED) in <foreach item="item" collection="statelist" open="(" separator="," close=")">#{item}</foreach></if>
            )
        </if>
        <!-- 有搜索条件时执行 -->
        <if test="uid != null and uid != '' and year != null  and year != ''
          and (reportTheme != null and reportTheme != ''
          or keyanshi != null and keyanshi != ''
          or teacherName != null and teacherName != ''
          or hostUnit != null and hostUnit != ''
          or reportPlace != null and reportPlace != ''
          or reportSubject != null and reportSubject != ''
          or reportClassify != null and reportClassify != '')">
            or (
            s.user_id = #{uid} and YEAR(DATE_ADD(report_time,INTERVAL 1 MONTH)) = #{year}
            <if test="reportTheme != null and reportTheme != ''">
                and report_theme like concat('%', #{reportTheme}, '%')
            </if>
            <if test="keyanshi != null and keyanshi != ''">
                and d.dept_name like concat('%', #{keyanshi}, '%')
            </if>
            <if test="teacherName != null and teacherName != ''">
                and u.user_name like concat('%', #{teacherName}, '%')
            </if>
            <if test="hostUnit != null and hostUnit != ''">
                and host_unit like concat('%', #{hostUnit}, '%')
            </if>
            <if test="reportPlace != null and reportPlace != ''">
                and report_place like concat('%', #{reportPlace}, '%')
            </if>
            <if test="reportSubject != null and reportSubject != ''">
                and report_subject like concat('%', #{reportSubject}, '%')
            </if>
            <if test="reportClassify != null and reportClassify != ''">
                and report_classify = #{reportClassify}
            </if>
            <if test="statelist != null and statelist.size() > 0">
                and CAST(s.state AS UNSIGNED) in <foreach item="item" collection="statelist" open="(" separator="," close=")">#{item}</foreach>
            </if>
            )
        </if>
        order by
        CASE
        <if test="uid != null and uid != ''">
            WHEN s.user_id = #{uid} AND CAST(state AS UNSIGNED) IN (3, 5, 7) THEN 0
            ELSE 1
        </if>
        <if test="uid == null or uid == ''">
            WHEN 1=1 THEN 1
        </if>
        END,
        CASE
        WHEN CAST(state AS UNSIGNED) = 1 THEN 2
        WHEN CAST(state AS UNSIGNED) = 6 THEN 3
        WHEN CAST(state AS UNSIGNED) = 2 THEN 4

        WHEN CAST(state AS UNSIGNED) = 5 THEN 5
        WHEN CAST(state AS UNSIGNED) = 7 THEN 6
        WHEN CAST(state AS UNSIGNED) = 3 THEN 7

        WHEN CAST(state AS UNSIGNED) = 4 THEN 8
        END,
        createtime desc
    </select>

