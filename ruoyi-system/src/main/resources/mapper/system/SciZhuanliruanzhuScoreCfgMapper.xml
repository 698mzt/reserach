    <sql id="selectSciZhuanliruanzhuScoreCfgVo">
        select id, fen_lei, pai_ming, total_score, update_user, update_time from sci_zhuanliruanzhu_score_cfg
    </sql>

    <select id="selectSciZhuanliruanzhuScoreCfgList" parameterType="SciZhuanliruanzhuScoreCfg" resultMap="SciZhuanliruanzhuScoreCfgResult">
        <include refid="selectSciZhuanliruanzhuScoreCfgVo"/>
