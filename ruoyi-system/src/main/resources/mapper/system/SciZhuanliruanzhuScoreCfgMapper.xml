            <if test="fenLei != null  and fenLei != ''"> and fen_lei like concat('%', #{fenLei}, '%')</if>
            <if test="paiMing != null  and paiMing != ''"> and pai_ming = #{paiMing}</if>
            <if test="totalScore != null  and totalScore != ''"> and total_score = #{totalScore}</if>
            <if test="updateUser != null  and updateUser != ''"> and update_user like concat('%', #{updateUser}, '%')</if>
        </where>
    </select>
    
    <select id="selectSciZhuanliruanzhuScoreCfgById" parameterType="Long" resultMap="SciZhuanliruanzhuScoreCfgResult">
        <include refid="selectSciZhuanliruanzhuScoreCfgVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSciZhuanliruanzhuScoreCfg" parameterType="SciZhuanliruanzhuScoreCfg" useGeneratedKeys="true" keyProperty="id">
        insert into sci_zhuanliruanzhu_score_cfg
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="fenLei != null and fenLei != ''">fen_lei,</if>
            <if test="paiMing != null and paiMing != ''">pai_ming,</if>
            <if test="totalScore != null and totalScore != ''">total_score,</if>
            <if test="updateUser != null">update_user,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="fenLei != null and fenLei != ''">#{fenLei},</if>
            <if test="paiMing != null and paiMing != ''">#{paiMing},</if>
            <if test="totalScore != null and totalScore != ''">#{totalScore},</if>
            <if test="updateUser != null">#{updateUser},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSciZhuanliruanzhuScoreCfg" parameterType="SciZhuanliruanzhuScoreCfg">
        update sci_zhuanliruanzhu_score_cfg
        <trim prefix="SET" suffixOverrides=",">
            <if test="fenLei != null and fenLei != ''">fen_lei = #{fenLei},</if>
            <if test="paiMing != null and paiMing != ''">pai_ming = #{paiMing},</if>
            <if test="totalScore != null and totalScore != ''">total_score = #{totalScore},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
