<mapper namespace="com.ruoyi.system.mapper.SciZhuanliruanzhuScoreCfgMapper">
    
    <resultMap type="SciZhuanliruanzhuScoreCfg" id="SciZhuanliruanzhuScoreCfgResult">
        <result property="id"    column="id"    />
        <result property="fenLei"    column="fen_lei"    />
        <result property="paiMing"    column="pai_ming"    />
        <result property="totalScore"    column="total_score"    />
