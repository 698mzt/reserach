    <delete id="deleteSciZhuanliruanzhuScoreCfgById" parameterType="Long">
        delete from sci_zhuanliruanzhu_score_cfg where id = #{id}
    </delete>

    <delete id="deleteSciZhuanliruanzhuScoreCfgByIds" parameterType="String">
        delete from sci_zhuanliruanzhu_score_cfg where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
