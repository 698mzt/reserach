<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SciPaperACfgMapper">
    <sql id="selectSciPaperACfgVo">

    </sql>

    <select id="selectSciPaperACfg">
        select * from sci_paper_cfg
<!--        <where>-->
<!--            <if test="id != null  and id != ''"> and id = #{id}</if>-->
<!--        </where>-->
    </select>
    <select id="selectSciPaperACfgPoints">
        select points from sci_paper_cfg
        <where>
            <if test="order != null and order != ''">AND `order` = #{order}</if>
            <if test="user_order != null and user_order != ''">AND user_order = #{user_order}</if>
        </where>
    </select>

    <select id="selectSciPaperACfgId"  parameterType="SciPaperCfg">
        select * from  sci_paper_cfg
        <where>
            <if test="id != null and id != ''">AND `id` = #{id}</if>
        </where>
    </select>

    <select id="selectSciPaperACfgPointList"  parameterType="string">
        select points from sci_paper_cfg
        <where>
            <if test="_parameter != null and _parameter != ''">AND `order` = #{_parameter}</if>
        </where>
        order by user_order asc
    </select>
    <insert id="insertSciPaperCfg" parameterType="SciPaperCfg" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sci_paper_cfg
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="order != null">`order`,</if>
            <if test="user_order != null">`user_order`,</if>
            <if test="points != null">`points`,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="order != null">#{order},</if>
            <if test="user_order != null">#{user_order},</if>
            <if test="points != null">#{points},</if>
        </trim>
    </insert>
    <update id="updateSciPaperCfg">
        UPDATE sci_paper_cfg
        <set>
            <if test="order != null">`order` = #{order},</if>
            <if test="user_order != null">`user_order` = #{user_order},</if>
            <if test="points != null">`points` = #{points},</if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>