<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysApprovalProcessMapper">

    <resultMap type="SysApprovalProcess" id="SysApprovalProcessResult">
        <result property="id"    column="id"    />
        <result property="processCode"    column="process_code"    />
        <result property="processName"    column="process_name"    />
        <result property="businessTable"    column="business_table"    />
        <result property="statusField"    column="status_field"    />
        <result property="sort"    column="sort"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysApprovalProcessVo">
        select id, process_code, process_name, business_table, status_field, sort, status, create_by, create_time, update_by, update_time, remark from sys_approval_process
    </sql>

    <select id="selectSysApprovalProcessList" parameterType="SysApprovalProcess" resultMap="SysApprovalProcessResult">
        <include refid="selectSysApprovalProcessVo"/>
        <where>
            <if test="processCode != null  and processCode != ''"> and process_code like concat('%', #{processCode}, '%')</if>
            <if test="processName != null  and processName != ''"> and process_name like concat('%', #{processName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort asc, id desc
    </select>

    <select id="selectSysApprovalProcessById" parameterType="Long" resultMap="SysApprovalProcessResult">
        <include refid="selectSysApprovalProcessVo"/>
        where id = #{id}
    </select>

    <insert id="insertSysApprovalProcess" parameterType="SysApprovalProcess" useGeneratedKeys="true" keyProperty="id">
        insert into sys_approval_process
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="processCode != null and processCode != ''">process_code,</if>
            <if test="processName != null and processName != ''">process_name,</if>
            <if test="businessTable != null and businessTable != ''">business_table,</if>
            <if test="statusField != null and statusField != ''">status_field,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="processCode != null and processCode != ''">#{processCode},</if>
            <if test="processName != null and processName != ''">#{processName},</if>
            <if test="businessTable != null and businessTable != ''">#{businessTable},</if>
            <if test="statusField != null and statusField != ''">#{statusField},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysApprovalProcess" parameterType="SysApprovalProcess">
        update sys_approval_process
        <trim prefix="SET" suffixOverrides=",">
            <if test="processCode != null and processCode != ''">process_code = #{processCode},</if>
            <if test="processName != null and processName != ''">process_name = #{processName},</if>
            <if test="businessTable != null and businessTable != ''">business_table = #{businessTable},</if>
            <if test="statusField != null and statusField != ''">status_field = #{statusField},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysApprovalProcessById" parameterType="Long">
        delete from sys_approval_process where id = #{id}
    </delete>

    <delete id="deleteSysApprovalProcessByIds" parameterType="Long[]">
        delete from sys_approval_process where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectSysApprovalProcessByProcessCode" parameterType="String" resultMap="SysApprovalProcessResult">
        <include refid="selectSysApprovalProcessVo"/>
        where process_code = #{processCode}
    </select>
</mapper>
