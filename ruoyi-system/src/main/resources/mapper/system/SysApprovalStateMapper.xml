<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysApprovalStateMapper">

    <resultMap type="SysApprovalState" id="SysApprovalStateResult">
        <result property="id"    column="id"    />
        <result property="stateCode"    column="state_code"    />
        <result property="stateName"    column="state_name"    />
        <result property="processCode"    column="process_code"    />
        <result property="sort"    column="sort"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysApprovalStateVo">
        select id, state_code, state_name, process_code, sort, status, create_by, create_time, update_by, update_time, remark from sys_approval_state
    </sql>

    <select id="selectSysApprovalStateList" parameterType="SysApprovalState" resultMap="SysApprovalStateResult">
        <include refid="selectSysApprovalStateVo"/>
        <where>
            <if test="stateCode != null  and stateCode != ''"> and state_code like concat('%', #{stateCode}, '%')</if>
            <if test="stateName != null  and stateName != ''"> and state_name like concat('%', #{stateName}, '%')</if>
            <if test="processCode != null  and processCode != ''"> and process_code = #{processCode}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort asc, id desc
    </select>

    <select id="selectSysApprovalStateById" parameterType="Long" resultMap="SysApprovalStateResult">
        <include refid="selectSysApprovalStateVo"/>
        where id = #{id}
    </select>

    <select id="selectSysApprovalStateByProcessCode" parameterType="String" resultMap="SysApprovalStateResult">
        <include refid="selectSysApprovalStateVo"/>
        where process_code = #{processCode} and status = '0'
        order by sort asc
    </select>

    <insert id="insertSysApprovalState" parameterType="SysApprovalState" useGeneratedKeys="true" keyProperty="id">
        insert into sys_approval_state
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="stateCode != null and stateCode != ''">state_code,</if>
            <if test="stateName != null and stateName != ''">state_name,</if>
            <if test="processCode != null and processCode != ''">process_code,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="stateCode != null and stateCode != ''">#{stateCode},</if>
            <if test="stateName != null and stateName != ''">#{stateName},</if>
            <if test="processCode != null and processCode != ''">#{processCode},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysApprovalState" parameterType="SysApprovalState">
        update sys_approval_state
        <trim prefix="SET" suffixOverrides=",">
            <if test="stateCode != null and stateCode != ''">state_code = #{stateCode},</if>
            <if test="stateName != null and stateName != ''">state_name = #{stateName},</if>
            <if test="processCode != null and processCode != ''">process_code = #{processCode},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysApprovalStateById" parameterType="Long">
        delete from sys_approval_state where id = #{id}
    </delete>

    <delete id="deleteSysApprovalStateByIds" parameterType="Long[]">
        delete from sys_approval_state where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
