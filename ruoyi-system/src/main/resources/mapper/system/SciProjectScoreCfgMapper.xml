<mapper namespace="com.ruoyi.system.mapper.SciProjectScoreCfgMapper">
    
    <resultMap type="SciProjectScoreCfg" id="SciProjectScoreCfgResult">
        <result property="id"    column="id"    />
        <result property="fundsMax"    column="funds_max"    />
        <result property="fundsMin"    column="funds_min"    />
        <result property="userOrder"    column="user_order"    />
        <result property="totalScore"    column="total_score"    />
        <result property="startScore"    column="start_score"    />
        <result property="endScore"    column="end_score"    />
        <result property="updateUser"    column="update_user"    />
        <result property="updateTime"    column="update_time"    />
        <result property="projectType"    column="project_type"    />
    </resultMap>

    <sql id="selectSciProjectScoreCfgVo">
        select id, funds_max, funds_min, user_order, total_score, start_score, end_score, update_user, update_time, project_type from sci_project_score_cfg
    </sql>

    <select id="selectSciProjectScoreCfgList" parameterType="SciProjectScoreCfg" resultMap="SciProjectScoreCfgResult">
        <include refid="selectSciProjectScoreCfgVo"/>
        <where>  
            <if test="fundsMax != null  and fundsMax != ''"> and funds_max = #{fundsMax}</if>
            <if test="fundsMin != null  and fundsMin != ''"> and funds_min = #{fundsMin}</if>
            <if test="userOrder != null  and userOrder != ''"> and user_order = #{userOrder}</if>
            <if test="totalScore != null  and totalScore != ''"> and total_score = #{totalScore}</if>
            <if test="startScore != null  and startScore != ''"> and start_score = #{startScore}</if>
            <if test="endScore != null  and endScore != ''"> and end_score = #{endScore}</if>
            <if test="updateUser != null  and updateUser != ''"> and update_user = #{updateUser}</if>
            <if test="projectType != null  and projectType != ''"> and project_type = #{projectType}</if>
        </where>
    </select>
    
    <select id="selectSciProjectScoreCfgById" parameterType="Long" resultMap="SciProjectScoreCfgResult">
        <include refid="selectSciProjectScoreCfgVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSciProjectScoreCfg" parameterType="SciProjectScoreCfg" useGeneratedKeys="true" keyProperty="id">
        insert into sci_project_score_cfg
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="fundsMax != null">funds_max,</if>
            <if test="fundsMin != null">funds_min,</if>
            <if test="userOrder != null">user_order,</if>
            <if test="totalScore != null">total_score,</if>
            <if test="startScore != null">start_score,</if>
            <if test="endScore != null">end_score,</if>
            <if test="updateUser != null">update_user,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="projectType != null">project_type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="fundsMax != null">#{fundsMax},</if>
            <if test="fundsMin != null">#{fundsMin},</if>
            <if test="userOrder != null">#{userOrder},</if>
            <if test="totalScore != null">#{totalScore},</if>
            <if test="startScore != null">#{startScore},</if>
            <if test="endScore != null">#{endScore},</if>
            <if test="updateUser != null">#{updateUser},</if>
            <if test="updateTime != null">now(),</if>
            <if test="projectType != null">#{projectType},</if>
         </trim>
    </insert>

    <update id="updateSciProjectScoreCfg" parameterType="SciProjectScoreCfg">
        update sci_project_score_cfg
        <trim prefix="SET" suffixOverrides=",">
            <if test="fundsMax != null">funds_max = #{fundsMax},</if>
            <if test="fundsMin != null">funds_min = #{fundsMin},</if>
            <if test="userOrder != null">user_order = #{userOrder},</if>
            <if test="totalScore != null">total_score = #{totalScore},</if>
            <if test="startScore != null">start_score = #{startScore},</if>
            <if test="endScore != null">end_score = #{endScore},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="projectType != null">project_type = #{projectType},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSciProjectScoreCfgById" parameterType="Long">
        delete from sci_project_score_cfg where id = #{id}
    </delete>

    <delete id="deleteSciProjectScoreCfgByIds" parameterType="String">
        delete from sci_project_score_cfg where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>