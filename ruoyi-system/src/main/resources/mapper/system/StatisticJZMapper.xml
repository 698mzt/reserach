<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.StatisticJZMapper">
    <select id="selectAllJZ" resultType="map">
        SELECT
            a.*
        FROM Alltotle a
        WHERE deptId = #{dept}
    </select>

    <select id="selectYJCGSXY" resultType="map">
        SELECT
            a.*
        FROM Alltotle a
        WHERE partenId = #{parentId}
    </select>
</mapper>