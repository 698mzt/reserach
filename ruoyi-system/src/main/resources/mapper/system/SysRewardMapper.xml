<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysRewardMapper">
    
    <resultMap type="SysReward" id="SysRewardResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="rewardName"    column="reward_name"    />
        <result property="rewardDanwei"    column="reward_danwei"    />
        <result property="rewardLeixing"    column="reward_leixing"    />
        <result property="rewardWenjian"    column="reward_wenjian"    />
        <result property="rewardTime"    column="reward_time"    />
        <result property="rewardFenlei"    column="reward_fenlei"    />
        <result property="rewardDengji"    column="reward_dengji"    />
        <result property="rewardPaiming"    column="reward_paiming"    />
        <result property="rewardJibie"    column="reward_jibie"    />
        <result property="userName"    column="userName"    />
        <result property="jifen"    column="jifen"    />
        <result property="state"    column="state"    />
        <result  property="parentId" column="parent_id" />
        <result  property="dname" column="dname" />
        <result  property="yname" column="yname" />
    </resultMap>

    <sql id="selectSysRewardVo">
        select #{uid} uid,s.id, u.user_name username, d.dept_name dname,p.dept_name yname,s.jifen,s.user_id,s.reward_name, s.reward_danwei, s.reward_leixing, s.reward_wenjian, s.reward_time, s.reward_fenlei, s.reward_dengji, s.reward_paiming, s.reward_jibie,s.state
        from sys_reward s left join sys_user u on  s.user_id= u.user_id
                          left join sys_dept d on u.dept_id = d.dept_id
                          left join sys_dept p on d.parent_id =p.dept_id
    </sql>

    <select id="selectSysRewardList" parameterType="SysReward" resultMap="SysRewardResult">
        <include refid="selectSysRewardVo"/>
        <where>
--             (state in (1,2,3,4,5,6,7,11))
            (state in (1,2,3,4,5,6,7,11) and s.user_id = #{uid})
            <if test="userId != null">
                AND s.user_id = #{userId}
            </if>
            <if test="rewardName != null  and rewardName != ''"> and reward_name like concat('%', #{rewardName}, '%')</if>
            <if test="yname != null  and yname != ''"> and yname = #{yname}</if>
            <if test="dname != null and dname != ''">
                AND d.dept_name = #{dname}
            </if>
--             <if test="rewardDanwei != null  and rewardDanwei != ''"> and reward_danwei = #{rewardDanwei}</if>
--             <if test="rewardLeixing != null  and rewardLeixing != ''"> and reward_leixing = #{rewardLeixing}</if>
--             <if test="rewardWenjian != null  and rewardWenjian != ''"> and reward_wenjian = #{rewardWenjian}</if>
            <if test="rewardTime != null "> and reward_time = #{rewardTime}</if>
--             <if test="rewardFenlei != null  and rewardFenlei != ''"> and reward_fenlei = #{rewardFenlei}</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
--             <if test="rewardDengji != null  and rewardDengji != ''"> and reward_dengji like concat('%', #{rewardDengji}, '%')</if>
--             <if test="rewardPaiming != null  and rewardPaiming != ''"> and reward_paiming = #{rewardPaiming}</if>
            <if test="rewardJibie != null  and rewardJibie != ''"> and like concat('%', #{rewardJibie}, '%')</if>
            <if test="state != null  and state != ''"> and state = #{state}</if>

            ${params.dataScope}

            order  by state ,reward_time desc
        </where>
    </select>
    
    <select id="selectSysRewardById" parameterType="Long" resultMap="SysRewardResult">
        <include refid="selectSysRewardVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysReward" parameterType="SysReward" useGeneratedKeys="true" keyProperty="id">
        insert into sys_reward
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="rewardName != null and rewardName != ''">reward_name,</if>
            <if test="rewardDanwei != null and rewardDanwei != ''">reward_danwei,</if>
            <if test="rewardLeixing != null and rewardLeixing != ''">reward_leixing,</if>
            <if test="rewardWenjian != null and rewardWenjian != ''">reward_wenjian,</if>
            <if test="rewardTime != null">reward_time,</if>
            <if test="rewardFenlei != null and rewardFenlei != ''">reward_fenlei,</if>
            <if test="rewardDengji != null and rewardDengji != ''">reward_dengji,</if>
            <if test="rewardPaiming != null and rewardPaiming != ''">reward_paiming,</if>
            <if test="rewardJibie != null and rewardJibie != ''">reward_jibie,</if>
            <if test="state != null and state != ''">state,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="rewardName != null and rewardName != ''">#{rewardName},</if>
            <if test="rewardDanwei != null and rewardDanwei != ''">#{rewardDanwei},</if>
            <if test="rewardLeixing != null and rewardLeixing != ''">#{rewardLeixing},</if>
            <if test="rewardWenjian != null and rewardWenjian != ''">#{rewardWenjian},</if>
            <if test="rewardTime != null">#{rewardTime},</if>
            <if test="rewardFenlei != null and rewardFenlei != ''">#{rewardFenlei},</if>
            <if test="rewardDengji != null and rewardDengji != ''">#{rewardDengji},</if>
            <if test="rewardPaiming != null and rewardPaiming != ''">#{rewardPaiming},</if>
            <if test="rewardJibie != null and rewardJibie != ''">#{rewardJibie},</if>
            <if test="state != null and state != ''">#{state},</if>
         </trim>
    </insert>

    <update id="updateSysReward" parameterType="SysReward">
        update sys_reward
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="rewardName != null and rewardName != ''">reward_name = #{rewardName},</if>
            <if test="rewardDanwei != null and rewardDanwei != ''">reward_danwei = #{rewardDanwei},</if>
            <if test="rewardLeixing != null and rewardLeixing != ''">reward_leixing = #{rewardLeixing},</if>
            <if test="rewardWenjian != null and rewardWenjian != ''">reward_wenjian = #{rewardWenjian},</if>
            <if test="rewardTime != null">reward_time = #{rewardTime},</if>
            <if test="rewardFenlei != null and rewardFenlei != ''">reward_fenlei = #{rewardFenlei},</if>
            <if test="rewardDengji != null and rewardDengji != ''">reward_dengji = #{rewardDengji},</if>
            <if test="rewardPaiming != null and rewardPaiming != ''">reward_paiming = #{rewardPaiming},</if>
            <if test="rewardJibie != null and rewardJibie != ''">reward_jibie = #{rewardJibie},</if>
            <if test="state != null and state != ''">state=#{state},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysRewardById" parameterType="Long">
        delete from sys_reward where id = #{id}
    </delete>

    <delete id="deleteSysRewardByIds" parameterType="String">
        delete from sys_reward where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    <select id="selectSysRewardListByJYS" parameterType="SysReward" resultMap="SysRewardResult">
        select #{uid} uid,s.id, u.user_name username, d.dept_name dname,p.dept_name yname,s.user_id,s.jifen,s.reward_name, s.reward_danwei, s.reward_leixing, s.reward_wenjian, s.reward_time, s.reward_fenlei, s.reward_dengji, s.reward_paiming, s.reward_jibie,s.state
        from sys_reward s left join sys_user u on  s.user_id= u.user_id
        left join sys_dept d on u.dept_id = d.dept_id
        left join sys_dept p on d.parent_id =p.dept_id
        where s.user_id = #{uid} or state in (1,2)
        <!--            <if test="userId != null "> and user_id = #{userId}</if>-->
        <if test="yname != null  and yname != ''"> and yname = #{yname}</if>
        <if test="rewardName != null  and rewardName != ''"> and reward_name like concat('%', #{rewardName}, '%')</if>
        <if test="rewardTime != null "> and reward_time = #{rewardTime}</if>
        <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
        <if test="state != null  and state != ''"> and state = #{state}</if>
        <if test="dname != null and dname != ''">
            AND d.dept_name = #{dname}
        </if>
        <if test="state != null and state != ''">
            AND state = #{state}
        </if>
        ${params.dataScope}
        order  by state ,reward_time desc
    </select>


    <select id="selectSysRewardListByXUE" parameterType="SysReward" resultMap="SysRewardResult">
        select #{uid} uid,s.id, u.user_name username, d.dept_name dname,p.dept_name yname,s.user_id,s.jifen,s.reward_name, s.reward_danwei, s.reward_leixing, s.reward_wenjian, s.reward_time, s.reward_fenlei, s.reward_dengji, s.reward_paiming, s.reward_jibie,s.state
        from sys_reward s left join sys_user u on  s.user_id= u.user_id
        left join sys_dept d on u.dept_id = d.dept_id
        left join sys_dept p on d.parent_id =p.dept_id
        where (s.user_id = #{uid} or (state in (2,4) and d.parent_id = #{parentId}))
        <!--            <if test="userId != null "> and user_id = #{userId}</if>-->
        <if test="yname != null  and yname != ''"> and yname = #{yname}</if>
        <if test="rewardName != null  and rewardName != ''"> and reward_name like concat('%', #{rewardName}, '%')</if>
        <if test="rewardTime != null "> and reward_time = #{rewardTime}</if>
        <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
        <if test="state != null  and state != ''"> and state = #{state}</if>
        <if test="dname != null and dname != ''"> AND d.dept_name = #{dname}</if>

        order  by state ,reward_time desc
    </select>


    <select id="selectSysRewardListByKYC" parameterType="SysReward" resultMap="SysRewardResult">
