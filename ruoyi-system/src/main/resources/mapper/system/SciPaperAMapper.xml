    <sql id="selectSciPaperAVo">
        select id, college, research_room, employee_id, teacher_name, administrative_position, social_title, on_campus_title, author_type, paper_title, paper_category, published_journal, inclusion_status, publication_time, is_industry_collaborative, is_local_collaborative, is_international_collaborative, is_cross_discipline, paper_ranking, research_score, remarks
        from sci_paper_a
    </sql>

    <select id="selectSciPaperAList" parameterType="SciPaperA" resultMap="SciPaperAResult">
        <include refid="selectSciPaperAVo"/>
        <where>
           <!-- <if test="college != null  and college != ''"> and college = #{college}</if>
            <if test="researchRoom != null  and researchRoom != ''"> and research_room = #{researchRoom}</if>
            <if test="employeeId != null  and employeeId != ''"> and employee_id = #{employeeId}</if>-->
            <if test="teacherName != null  and teacherName != ''"> and teacher_name like concat('%', #{teacherName}, '%')</if>
            <!--<if test="administrativePosition != null  and administrativePosition != ''"> and administrative_position = #{administrativePosition}</if>
            <if test="socialTitle != null  and socialTitle != ''"> and social_title = #{socialTitle}</if>
            <if test="onCampusTitle != null  and onCampusTitle != ''"> and on_campus_title = #{onCampusTitle}</if>
            <if test="authorType != null  and authorType != ''"> and author_type = #{authorType}</if>-->

            <if test="paperTitle != null  and paperTitle != ''"> and paper_title = #{paperTitle}</if>
            <if test="paperCategory != null  and paperCategory != ''"> and paper_category = #{paperCategory}</if>
            <if test="publishedJournal != null  and publishedJournal != ''"> and published_journal = #{publishedJournal}</if>
            <if test="inclusionStatus != null  and inclusionStatus != ''"> and inclusion_status = #{inclusionStatus}</if>
            <if test="publicationTime != null "> and publication_time = #{publicationTime}</if>
            <if test="isIndustryCollaborative != null  and isIndustryCollaborative != ''"> and is_industry_collaborative = #{isIndustryCollaborative}</if>
            <if test="isLocalCollaborative != null  and isLocalCollaborative != ''"> and is_local_collaborative = #{isLocalCollaborative}</if>
            <if test="isInternationalCollaborative != null  and isInternationalCollaborative != ''"> and is_international_collaborative = #{isInternationalCollaborative}</if>
            <if test="isCrossDiscipline != null  and isCrossDiscipline != ''"> and is_cross_discipline = #{isCrossDiscipline}</if>
            <if test="paperRanking != null  and paperRanking != ''"> and paper_ranking = #{paperRanking}</if>
            <if test="researchScore != null  and researchScore != ''"> and research_score = #{researchScore}</if>
            <if test="remarks != null  and remarks != ''"> and remarks = #{remarks}</if>
            <if test="year != null  and year != ''"> and YEAR(publication_time) = #{year}</if>
<!--            <if test="year != null  and year != ''"> and YEAR(DATE_ADD(signing_data,INTERVAL 1 MONTH)) = #{year}</if>-->


        </where>
    </select>

    <select id="selectSciPaperAById" parameterType="Long" resultMap="SciPaperAResult">
        <include refid="selectSciPaperAVo"/>
        where id = #{id}
    </select>

