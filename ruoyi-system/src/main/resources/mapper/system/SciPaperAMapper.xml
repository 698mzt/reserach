            <if test="onCampusTitle != null">on_campus_title,</if>&ndash;&gt;
            <if test="authorType != null">author_type,</if>-->
            <if test="paperTitle != null">paper_title,</if>
            <if test="paperCategory != null">paper_category,</if>
            <if test="publishedJournal != null">published_journal,</if>
            <if test="inclusionStatus != null">inclusion_status,</if>
            <if test="publicationTime != null">publication_time,</if>
