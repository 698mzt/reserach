            <if test="researchRoom != null">research_room = #{researchRoom},</if>
            <if test="employeeId != null">employee_id = #{employeeId},</if>-->
            <if test="teacherName != null">teacher_name = #{teacherName},</if>
        <!--<if test="administrativePosition != null">administrative_position = #{administrativePosition},</if>
            <if test="socialTitle != null">social_title = #{socialTitle},</if>
            <if test="onCampusTitle != null">on_campus_title = #{onCampusTitle},</if>
