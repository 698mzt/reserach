<mapper namespace="com.ruoyi.system.mapper.SciPaperAMapper">

    <resultMap type="SciPaperA" id="SciPaperAResult">

        <result property="id"    column="id"    />
        <result property="college"    column="college"    />
        <result property="researchRoom"    column="research_room"    />
        <result property="employeeId"    column="employee_id"    />
        <result property="teacherName"    column="teacher_name"    />
        <result property="administrativePosition"    column="administrative_position"    />
        <result property="socialTitle"    column="social_title"    />
        <result property="onCampusTitle"    column="on_campus_title"    />
        <result property="authorType"    column="author_type"    />

        <result property="signingData"    column="signing_data"    />
        <result property="paperTitle"    column="paper_title"    />
        <result property="paperCategory"    column="paper_category"    />
        <result property="publishedJournal"    column="published_journal"    />
        <result property="inclusionStatus"    column="inclusion_status"    />
        <result property="publicationTime"    column="publication_time"    />
        <result property="isIndustryCollaborative"    column="is_industry_collaborative"    />
