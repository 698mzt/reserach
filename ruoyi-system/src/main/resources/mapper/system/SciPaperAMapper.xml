        <result property="isInternationalCollaborative"    column="is_international_collaborative"    />
        <result property="isCrossDiscipline"    column="is_cross_discipline"    />
        <result property="paperRanking"    column="paper_ranking"    />
        <result property="researchScore"    column="research_score"    />
        <result property="remarks"    column="remarks"    />

        <result property="year"    column="year"    />
